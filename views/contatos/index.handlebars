<h1>Contatos dos Campi</h1>

<a href="/contatos/novo">
    <button>Novo Contato</button>
</a>

<form action="/contatos" method="GET">
  <label for="campus" class="visually-hidden">Pesquisar campus</label>
    <input
        type="text"
        id="campus"
        name="pesquisa"
        placeholder="Pesquisar campus..."
    >
    <button type="submit">Filtrar</button>
</form>

<br><br>

<br><br>

<table border="1" cellpadding="8">

    <tr>
        <th>Campus</th>
        <th>Telefone</th>
        <th>E-mail</th>
        <th>Ações</th>
    </tr>

    {{#each contatos}}

    <tr class="campus">

        <td>{{campus}}</td>

        <td>{{telefone}}</td>

        <td>{{email}}</td>

        <td>

            <a href="/contatos/editar/{{id}}">
                <button>Editar</button>
            </a>

            <form action="/contatos/deletar/{{id}}" method="POST" style="display:inline;">

                <button type="submit">
                    Excluir
                </button>

            </form>

        </td>

    </tr>

    {{/each}}

</table>

<script src="/js/contatos.js"></script>
