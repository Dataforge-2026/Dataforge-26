<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Usuários</title>
</head>

<body>

    <h1>Usuários Cadastrados</h1>

    <a href="/usuarios/novo">
        <button>Novo Usuário</button>
    </a>

    <br><br>

    <table border="1" cellpadding="8">

        <tr>
            <th scope="col">ID</th>
            <th scope="col">Nome</th>
            <th scope="col">Email</th>
            <th scope="col">Matrícula</th>
            <th scope="col">Campus</th>
            <th scope="col">Ações</th>
        </tr>

        {{#each usuarios}}

        <tr>

            <td>{{id}}</td>
            <td>{{nome}}</td>
            <td>{{email}}</td>
            <td>{{matricula}}</td>
            <td>{{campus}}</td>

            <td>

                <a href="/usuarios/editar/{{id}}">
                    <button>Editar</button>
                </a>

                <form action="/usuarios/deletar/{{id}}" method="POST" style="display:inline;">

                    <button type="submit">
                        Excluir
                    </button>

                </form>

            </td>

        </tr>

        {{/each}}

    </table>

</body>

</html>